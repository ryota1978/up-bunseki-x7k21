# 各キーが未設定の間は自動的にモックモードで動作します(APIキーなしで全体の流れを確認可能)

# --- Anthropic (Claude): 下地作成 & 画像+文章の自動レビュー ---
ANTHROPIC_API_KEY=

# --- OpenAI: イラスト生成 ---
OPENAI_API_KEY=

# --- Instagram Graph API: 投稿 ---
# Meta for Developers でアプリ登録 → Instagram Business アカウントと連携して取得
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# 生成した合成画像を一時的に公開するためのベースURL
# (Instagram Graph API は画像を「公開URL」からしか取得できないため、
#  ローカル実行中は ngrok 等でトンネルしたURLをここに入れる)
PUBLIC_BASE_URL=http://localhost:3000

PORT=3000
